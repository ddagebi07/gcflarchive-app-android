<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="@string/settings_meal_section"
            android:textAppearance="@style/TextAppearance.Gcfl.Section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:text="@string/notify_enable"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/permissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:text="@string/notify_permission_denied"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowTime"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:text="@string/notify_time"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/timeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowKind"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:text="@string/notify_kind"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/kindValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTest"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notify_test"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSystem"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notify_system"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/settings_account_section"
            android:textAppearance="@style/TextAppearance.Gcfl.Section" />

        <LinearLayout
            android:id="@+id/rowLogin"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLogout"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logout"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/settings_etc_section"
            android:textAppearance="@style/TextAppearance.Gcfl.Section" />

        <LinearLayout
            android:id="@+id/rowWebsite"
            style="@style/Widget.Gcfl.SettingsRow">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_website"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
