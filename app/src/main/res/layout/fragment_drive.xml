<?xml version="1.0" encoding="utf-8"?>
<!-- 극플드라이브 (share.html), native. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krds_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drive_title"
                android:textAppearance="@style/TextAppearance.Krds.PageTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drive_desc"
                android:textAppearance="@style/TextAppearance.Krds.PageDesc" />

            <!-- Logged out -->
            <LinearLayout
                android:id="@+id/loginGroup"
                style="@style/Widget.Gcfl.Card"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:paddingVertical="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/krds_primary_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/library_login_title"
                    android:textAppearance="@style/TextAppearance.Krds.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/drive_login_desc"
                    android:textAppearance="@style/TextAppearance.Krds.Meta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.Krds.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_login_banner_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/krds_danger"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 남은 용량 -->
                <LinearLayout
                    style="@style/Widget.Gcfl.Card"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/drive_storage_title"
                            android:textAppearance="@style/TextAppearance.Krds.CardTitle"
                            app:drawableStartCompat="@drawable/ic_drive"
                            app:drawableTint="@color/krds_primary_text" />

                        <TextView
                            android:id="@+id/countBadge"
                            style="@style/Widget.Krds.Badge"
                            android:background="@drawable/bg_krds_badge_info"
                            android:textColor="@color/krds_badge_info_fg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/drive_storage_limit"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />

                        <TextView
                            android:id="@+id/usageText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/krds_text_strong"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/usageBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        app:indicatorColor="@color/krds_primary"
                        app:trackColor="@color/krds_surface_raised"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />
                </LinearLayout>

                <!-- 보관 기한 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_krds_info_box"
                    android:drawablePadding="8dp"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="14dp"
                    android:text="@string/drive_retention"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/krds_text_primary"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="@color/krds_primary_text" />

                <!-- PIN / 드라이브 주소 -->
                <LinearLayout
                    style="@style/Widget.Gcfl.Card"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drive_pin_title"
                        android:textAppearance="@style/TextAppearance.Krds.DetailLabel" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pinText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_krds_badge_info"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/krds_badge_info_fg"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/driveUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/krds_text_secondary"
                            android:textIsSelectable="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/drive_pin_help"
                        android:textAppearance="@style/TextAppearance.Krds.Meta" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyUrl"
                            style="@style/Widget.Krds.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/drive_copy_url"
                            app:icon="@drawable/ic_copy"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangePin"
                            style="@style/Widget.Krds.Button.Tertiary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/drive_change_pin" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 업로드 -->
                <LinearLayout
                    android:id="@+id/dropzone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dropzone"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/krds_primary_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/drive_upload_title"
                        android:textAppearance="@style/TextAppearance.Krds.CardTitle"
                        android:textColor="@color/krds_primary_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/drive_upload_desc"
                        android:textAppearance="@style/TextAppearance.Krds.Meta" />
                </LinearLayout>

                <!-- 현재 보관 중인 파일 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/drive_files_title"
                    android:textAppearance="@style/TextAppearance.Gcfl.SectionTitle" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/krds_text_strong" />

                <LinearLayout
                    android:id="@+id/fileList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_full"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <LinearLayout
                    android:id="@+id/emptyBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drive_empty_title"
                        android:textAppearance="@style/TextAppearance.Krds.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/drive_empty_desc"
                        android:textAppearance="@style/TextAppearance.Krds.Meta" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
