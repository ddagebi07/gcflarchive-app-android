<?xml version="1.0" encoding="utf-8"?>
<!-- One post in 통합검색: badge · date, title, snippet, author. Rows are separated by an
     inset divider (SearchFragment) instead of cards, keeping the list minimal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/board"
            style="@style/Widget.Krds.Badge"
            android:background="@drawable/bg_krds_badge_info"
            android:textColor="@color/krds_badge_info_fg" />

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Krds.Meta" />

        <TextView
            android:id="@+id/attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Krds.Meta"
            android:textColor="@color/krds_primary_text"
            app:drawableStartCompat="@drawable/ic_attach"
            app:drawableTint="@color/krds_primary_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Krds.CardTitle" />

    <TextView
        android:id="@+id/snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/krds_text_secondary" />

    <TextView
        android:id="@+id/author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Krds.Meta" />
</LinearLayout>
