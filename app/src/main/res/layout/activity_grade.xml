<?xml version="1.0" encoding="utf-8"?>
<!-- 등급컷 계산기 (grade-calculator.html), native. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krds_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/krds_bg" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grade_title"
                    android:textAppearance="@style/TextAppearance.Krds.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/grade_desc"
                    android:textAppearance="@style/TextAppearance.Krds.PageDesc" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/krds_danger"
                    android:visibility="gone" />

                <!-- ── 접속 방식 선택 ── -->
                <LinearLayout
                    android:id="@+id/accessCard"
                    style="@style/Widget.Gcfl.Card"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grade_access_title"
                        android:textAppearance="@style/TextAppearance.Gcfl.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/grade_access_desc"
                        android:textAppearance="@style/TextAppearance.Krds.Meta" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/grade_grade_label"
                        android:textAppearance="@style/TextAppearance.Krds.DetailLabel" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/guestGradeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/grade_track_label"
                        android:textAppearance="@style/TextAppearance.Krds.DetailLabel" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/guestTrackGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartGuest"
                        style="@style/Widget.Krds.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/grade_start_guest" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCodeLogin"
                            style="@style/Widget.Krds.Button.Tertiary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/grade_code_login" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerify"
                            style="@style/Widget.Krds.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/grade_verify" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/accessStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_krds_info_box"
                        android:padding="12dp"
                        android:text="@string/grade_access_note"
                        android:textAppearance="@style/TextAppearance.Krds.Meta" />
                </LinearLayout>

                <!-- ── 원점수 동의 ── -->
                <LinearLayout
                    android:id="@+id/consentCard"
                    style="@style/Widget.Gcfl.Card"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grade_consent_title"
                        android:textAppearance="@style/TextAppearance.Gcfl.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_krds_info_box"
                        android:lineSpacingMultiplier="1.35"
                        android:padding="12dp"
                        android:text="@string/grade_consent_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/krds_text_primary" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/consentCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/grade_consent_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsent"
                        style="@style/Widget.Krds.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/grade_consent_submit" />
                </LinearLayout>

                <!-- ── 계산기 ── -->
                <LinearLayout
                    android:id="@+id/mainGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 1. 원점수 입력 -->
                    <LinearLayout
                        android:id="@+id/inputSection"
                        style="@style/Widget.Gcfl.Card"
                        android:layout_marginTop="20dp">

                        <TextView
                            style="@style/Widget.Gcfl.StepTitle"
                            android:text="@string/grade_step_input" />

                        <TextView
                            android:id="@+id/identity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />

                        <LinearLayout
                            android:id="@+id/guestRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone"
                        android:baselineAligned="false">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReselect"
                                style="@style/Widget.Krds.Button.Tertiary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grade_reselect" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMigrate"
                                style="@style/Widget.Krds.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/grade_migrate" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/inputRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:divider="@drawable/divider_full"
                            android:orientation="vertical"
                            android:showDividers="middle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitAll"
                            style="@style/Widget.Krds.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/grade_submit_all" />

                        <TextView
                            android:id="@+id/submitStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/grade_input_note"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />
                    </LinearLayout>

                    <!-- 2. 내 점수 -->
                    <LinearLayout
                        android:id="@+id/mineSection"
                        style="@style/Widget.Gcfl.Card"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/Widget.Gcfl.StepTitle"
                            android:text="@string/grade_step_mine" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/grade_mine_desc"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />

                        <LinearLayout
                            android:id="@+id/mineRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:divider="@drawable/divider_full"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </LinearLayout>

                    <!-- 통계 기준 (등급컷·오답률 공통) -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/statsModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/statsAll"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/grade_stats_all" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/statsVerified"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/grade_stats_verified" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- 3. 등급컷 -->
                    <LinearLayout
                        style="@style/Widget.Gcfl.Card"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/Widget.Gcfl.StepTitle"
                            android:text="@string/grade_step_cutoff" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cutoffSubjects"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/cutoffMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/cutoffStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />

                        <LinearLayout
                            android:id="@+id/cutoffRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:divider="@drawable/divider_full"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </LinearLayout>

                    <!-- 4. 오답률 -->
                    <LinearLayout
                        style="@style/Widget.Gcfl.Card"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/Widget.Gcfl.StepTitle"
                            android:text="@string/grade_step_wrong" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/wrongSubjects"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/wrongSort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/wrongMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/wrongStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.Krds.Meta" />

                        <LinearLayout
                            android:id="@+id/wrongRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:divider="@drawable/divider_full"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
