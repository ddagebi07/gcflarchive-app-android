<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krds_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_fingerprint"
        app:tint="@color/krds_primary_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/lock_title"
        android:textAppearance="@style/TextAppearance.Krds.PageTitle" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/lock_desc"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/krds_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        style="@style/Widget.Krds.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:minWidth="200dp"
        android:text="@string/lock_unlock" />
</LinearLayout>
