<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- DownloadManager writes to public Downloads; only pre-Q needs the permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".GcflApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GcflArchive">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared archive links (공유 → /search?s=게시판:번호) and the community open in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="gcflarchive.co.kr" />
                <data android:path="/search" />
                <data android:path="/community" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Former WebView pages, now native -->
        <activity
            android:name=".grade.GradeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".map.MapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".notice.NoticeListActivity"
            android:exported="false" />
        <activity
            android:name=".notice.NoticeDetailActivity"
            android:exported="false" />

        <!-- Native login + 개인정보 동의 (replaces the /verify web page) -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.FirstPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".archive.PostDetailActivity"
            android:exported="false" />

        <!-- Native archive pages (기출 / PDF / 사진 / 영상) and the protected PDF viewer -->
        <activity
            android:name=".library.PastExamsActivity"
            android:exported="false" />
        <activity
            android:name=".library.DocumentsActivity"
            android:exported="false" />
        <activity
            android:name=".library.PhotosActivity"
            android:exported="false" />
        <activity
            android:name=".library.VideosActivity"
            android:exported="false" />
        <activity
            android:name=".library.PdfViewerActivity"
            android:exported="false" />

        <!-- 설문조사 -->
        <activity
            android:name=".survey.SurveyListActivity"
            android:exported="false" />
        <activity
            android:name=".survey.SurveyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".survey.SurveyBuilderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".survey.SurveyResultsActivity"
            android:exported="false" />

        <!-- 커뮤니티 -->
        <activity
            android:name=".community.CommunityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".community.CommunityPostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".community.CommunityWriteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 더보기 -->
        <activity
            android:name=".grade.MyScoresActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- "공유" 시트에서 극플드라이브로 바로 올리기 -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:taskAffinity=""
            android:theme="@style/Theme.GcflArchive.Dialog">
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 학교생활 푸시 (FCM). Without app/google-services.json Firebase stays off and this never runs. -->
        <service
            android:name=".school.SchoolPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="school" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notice" />
    </application>
</manifest>
