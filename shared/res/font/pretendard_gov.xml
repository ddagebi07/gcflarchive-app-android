<?xml version="1.0" encoding="utf-8"?>
<!-- KRDS typeface: Pretendard GOV (variable, 'wght' 45–930). textStyle="bold" picks 700. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/pretendard_gov_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400"
        app:font="@font/pretendard_gov_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 400"
        app:fontWeight="400" />
    <font
        android:font="@font/pretendard_gov_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600"
        app:font="@font/pretendard_gov_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 600"
        app:fontWeight="600" />
    <font
        android:font="@font/pretendard_gov_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700"
        app:font="@font/pretendard_gov_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 700"
        app:fontWeight="700" />
</font-family>
