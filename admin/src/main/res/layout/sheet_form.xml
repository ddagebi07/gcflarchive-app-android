<?xml version="1.0" encoding="utf-8"?>
<!--
  Create/edit form. The fields scroll inside a height-capped area and the 취소/저장 bar
  is pinned below it, so the buttons stay visible for long forms and above the keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/formTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/krds_text_strong"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/formDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:textAppearance="@style/TextAppearance.Krds.Meta"
        android:visibility="gone" />

    <kr.co.gcflarchive.admin.ui.kit.CappedScrollView
        android:id="@+id/formScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/formFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />
    </kr.co.gcflarchive.admin.ui.kit.CappedScrollView>

    <View
        android:id="@+id/formDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/krds_border" />

    <TextView
        android:id="@+id/formError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/krds_danger"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/formActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/formCancel"
            style="@style/Widget.Krds.Button.Tertiary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/formSubmit"
            style="@style/Widget.Krds.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
